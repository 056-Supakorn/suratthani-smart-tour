# Environment Configuration Example
# Copy this file to .env and fill in your credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Surat
PORT=8000

# Admin account (log in from the regular Login form with this exact name + email)
ADMIN_NAME=ผู้ดูแลระบบ
ADMIN_EMAIL=admin@example.com
# Internal secret used to authorize admin-only API calls once logged in - never
# typed by the user, just keep it random and out of version control.
ADMIN_PASSWORD=<choose-a-strong-random-value>
