# Environment Configuration Example
# Copy this file to .env and fill in your credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Surat
PORT=8000

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the local Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin account - log in from the regular Login form with this exact name + email,
# and this exact value as the password. Also used to authorize admin-only API calls
# once logged in. Keep it random and out of version control.
ADMIN_NAME=ผู้ดูแลระบบ
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-random-value>

# Forgot-password emails (6-digit OTP) are sent through Brevo's HTTP API
# (free: 300 emails/day). Render's free plan blocks SMTP ports, so plain SMTP won't work there.
# 1) brevo.com -> sign up -> Senders, Domains & Dedicated IPs -> add + verify your sender email
# 2) SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=<your-brevo-api-key>
EMAIL_SENDER=<verified-sender@gmail.com>
EMAIL_SENDER_NAME=Surat Smart Tour
# Local testing only: print emails to the server log instead of sending them.
# EMAIL_DEV_LOG=1
